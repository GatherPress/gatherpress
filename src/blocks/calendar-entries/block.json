{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gatherpress/calendar-entries",
  "version": "0.1.0",
  "title": "Calendar Entries",
  "category": "gatherpress",
  "icon": "list-view",
  "description": "Lists a calendar day's events, one per event. Works like the Post Template block: its inner blocks are the template used to render each event - for now, that template is only used for the event's popover content.",
  "ancestor": [ "gatherpress/calendar-day" ],
  "usesContext": [
    "gatherpress/dayDate",
    "gatherpress/dayNumber",
    "gatherpress/dayPosts",
    "gatherpress/isEmpty",
    "gatherpress/enableTimeGrid",
    "gatherpress/timeGridConfig",
    "gatherpress/numRibbonSlots",
    "postType"
  ],
  "attributes": {
    "layout": {
      "type": "object",
      "default": {
        "type": "flex",
        "orientation": "vertical",
        "justifyContent": "right"
      }
    }
  },
  "supports": {
    "interactivity": {
      "clientNavigation": true
    },
    "html": false,
    "reusable": false,
    "layout": {
      "allowSwitching": true,
      "allowInheriting": false,
      "allowSizingOnChildren": false,
      "default": {
        "type": "flex",
        "orientation": "vertical",
        "justifyContent": "right"
      }
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "__experimentalDefaultControls": {
        "blockGap": true,
        "margin": false,
        "padding": false
      }
    },
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "__experimentalSkipSerialization": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "__experimentalSkipSerialization": true,
      "__experimentalSelector": ".gatherpress-calendar__entry"
    },
    "shadow": {
      "__experimentalSkipSerialization": true
    },
    "listView": true,
    "contentRole": true
  },
  "selectors": {
    "border": ".wp-block-gatherpress-calendar .gatherpress-calendar__entry",
    "color": ".wp-block-gatherpress-calendar .gatherpress-calendar__entry",
    "shadow": ".wp-block-gatherpress-calendar .gatherpress-calendar__entry"
  },
  "styles": [
    {
      "name": "default",
      "label": "Classic",
      "isDefault": true
    },
    {
      "name": "dots",
      "label": "Colored Dots"
    }
  ],
  "textdomain": "gatherpress",
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}